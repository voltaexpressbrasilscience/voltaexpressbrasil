# ==============================================================================
# BU LOGÍSTICA: VOLTA EXPRESS BRASIL
# Standard GitIgnore for Fullstack Ecosystem (Vite + Node + Supabase)
# ==============================================================================

# --- [ SISTEMAS E DEPENDÊNCIAS ] ---
node_modules/
dist/
dist-ssr/
*.local
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- [ VARIÁVEIS DE AMBIENTE (CRÍTICO) ] ---
# Nunca suba chaves do Supabase ou credenciais da BU para o GitHub
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# --- [ LOGS E DEBUG ] ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- [ FERRAMENTAS DE DESENVOLVIMENTO ] ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- [ TESTES E COBERTURA (VITEST/JEST) ] ---
coverage/
__snapshots__/

# --- [ CACHE E PERFORMANCE ] ---
.eslintcache
.stylelintcache
.next/
.cache/
.vite/
.turbo/

# --- [ SISTEMA OPERACIONAL ] ---
DS_Store
Thumbs.db
desktop.ini

# --- [ SUPABASE / BACKEND ] ---
supabase/.temp/
supabase/functions/.env